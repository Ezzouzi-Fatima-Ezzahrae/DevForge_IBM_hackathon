# Copy to .env if you want to change a setting. Never commit the real .env file.
# Every variable is optional. Names only, no secrets.

# Force one stage to its stub agent (real|stub, default real)
DEVFORGE_PLAN_AGENT_MODE=real
DEVFORGE_TEST_AGENT_MODE=real
DEVFORGE_DEBUG_AGENT_MODE=real
DEVFORGE_SECURITY_AGENT_MODE=real

# Do not record memory and metrics (on|off, default on)
DEVFORGE_MEMORY=on
